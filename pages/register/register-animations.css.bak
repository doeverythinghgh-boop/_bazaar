/**
 * @file register-animations.css
 * @description Keyframe animations and dynamic status styles for registration page elements.
 */

@keyframes gradient-animation {
    0% {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }
}

@keyframes slideDown {
    from {
        opacity: 0;
        max-height: 0;
    }

    to {
        opacity: 1;
        max-height: 1000px;
    }
}

@keyframes registerFadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Dynamic Status Styles (JS Hook) */
#register_seller-options-btn[data-status="set"] {
    background-color: #d1fae5;
    border-style: solid;
    color: #065f46;
}

#register_seller-options-btn[data-status="none"] {
    background-color: #f0fdf4;
    border-style: dashed;
    color: #166534;
}

@keyframes registerFadeUp {
    from {
        opacity: 0;
        transform: translateY(30px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes registerPulse {
    0% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(var(--primary-rgb), 0.4);
    }

    70% {
        transform: scale(1.02);
        box-shadow: 0 0 0 10px rgba(var(--primary-rgb), 0);
    }

    100% {
        transform: scale(1);
        box-shadow: 0 0 0 0 rgba(var(--primary-rgb), 0);
    }
}

@keyframes registerFloat {
    0% {
        transform: translateY(0);
    }

    50% {
        transform: translateY(-10px);
    }

    100% {
        transform: translateY(0);
    }
}

.brand-logo-wrapper {
    animation: registerFloat 4s ease-in-out infinite;
}

/* Background blob animation for a modern feel */
.register_page-wrapper::before,
.register_page-wrapper::after {
    content: '';
    position: fixed;
    width: 300px;
    height: 300px;
    border-radius: 50%;
    background: rgba(var(--primary-rgb), 0.03);
    filter: blur(80px);
    z-index: -1;
    pointer-events: none;
}

.register_page-wrapper::before {
    top: 10%;
    left: -100px;
    animation: registerBlobMove 20s infinite alternate;
}

.register_page-wrapper::after {
    bottom: 10%;
    right: -100px;
    background: rgba(var(--primary-rgb), 0.05);
    animation: registerBlobMove 25s infinite alternate-reverse;
}

@keyframes registerBlobMove {
    from {
        transform: translate(0, 0);
    }

    to {
        transform: translate(100px, 100px);
    }
}
